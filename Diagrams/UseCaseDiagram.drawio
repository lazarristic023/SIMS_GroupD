  <diagram id="CX0ABDplaBhs7XLENf1h" name="Pracenje ture uzivo">
    <mxGraphModel dx="1050" dy="491" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="VhsFqnnwMJ_tHOylrqHz-1" value="&lt;p style=&quot;margin: 4px 0px 0px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&amp;nbsp;Preduslov: &lt;/b&gt;Vodic je prijavljen, poceo je zakazani termin&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;b&gt;Posledica: &lt;/b&gt;Pracenje ture uzivo i zavrsavanje iste&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;b&gt;Osnovni tok:&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;1. Vodic uradi dvoklik na zeljenu turu&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;2. Otvara se prozor za detaljima o turi i dugmetom za zapocinjanje ture&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;3. Vodic klikom na dugme &quot;Start tour&quot; zapocinje turu [Alternativni tok A]&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;4. Vodic prelazi sa jedne tacke na drugu klikom na dugme &quot;Next point&quot;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; sve dok se ne prodju sve tacke [Alternativni tok B]&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;5. [Alternativni tok C]&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;6. Tura se zavrsava, a vodicu se prikazuje pocetni meni&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="390" height="220" as="geometry" />
        </mxCell>
        <mxCell id="VhsFqnnwMJ_tHOylrqHz-2" value="&lt;b&gt;Alternativni tok A: &lt;/b&gt;Nemogucnost startovanja ture" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=none;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="490" y="30" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="VhsFqnnwMJ_tHOylrqHz-3" value="1. Termin ture jos nije poceo ili je tura vec zavrsena, tako da je dugme za start onemoguceno" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="VhsFqnnwMJ_tHOylrqHz-2">
          <mxGeometry y="26" width="300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="VhsFqnnwMJ_tHOylrqHz-4" value="&lt;b&gt;Alternativni tok B: &lt;/b&gt;Prisilno zaustavljanje ture" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=none;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="490" y="180" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="VhsFqnnwMJ_tHOylrqHz-5" value="1. Vodic prisilno zaustavlja turu klikom na dugme &quot;Finish the tour&quot;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="VhsFqnnwMJ_tHOylrqHz-4">
          <mxGeometry y="26" width="340" height="104" as="geometry" />
        </mxCell>
        <mxCell id="VhsFqnnwMJ_tHOylrqHz-6" value="&lt;b&gt;Alternativni tok C: &lt;/b&gt;Dodavanje gostiju sa rezervacijom na turu" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=none;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="450" y="320" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="VhsFqnnwMJ_tHOylrqHz-7" value="1. Vodic je kliknuo na dugme &quot;Add guest to current point&quot;&lt;br&gt;2. Sistem prikazuje listu korisnika sa rezervacijom&lt;br&gt;3. Odabire gosta i dodaje ga kao prisutnog na turu" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="VhsFqnnwMJ_tHOylrqHz-6">
          <mxGeometry y="26" width="380" height="104" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
