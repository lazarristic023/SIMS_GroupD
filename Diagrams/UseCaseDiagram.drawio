        <mxCell id="MtK553Ue0QxPSUH9Ll_z-2" value="&lt;p style=&quot;margin: 4px 0px 0px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&amp;nbsp;Preduslov: &lt;/b&gt;Vodic je prijavljen&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;b&gt;Posledica: &lt;/b&gt;Kreirana je nova tura&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;b&gt;Osnovni tok:&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;1. Vodic otvara formu za kreiranje nove ture klikom na dugme &quot;Add new tour&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;2. Vodic popunjava formu sa neophodnim podacima&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;3. Voidc kreira turu klikom na &quot;Submit dugme&quot;. [Alternativni tok A]&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="370" height="140" as="geometry" />
