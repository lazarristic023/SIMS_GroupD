          <mxGeometry x="40" y="30" width="390" height="220" as="geometry" />
        </mxCell>
        <mxCell id="vkV2MvF70xdshmURmsRw-2" value="&lt;b&gt;Alternativni tok A: &lt;/b&gt;Vodic vec ima zakazanu turu u tom terminu" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=none;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="480" y="30" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="vkV2MvF70xdshmURmsRw-3" value="1. Vodicu iskace obavestenje da je zauzet u datom terminu.&lt;br&gt;2. Voidc ponovo odabire termin [Alternativni tok B]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="vkV2MvF70xdshmURmsRw-2">
          <mxGeometry y="26" width="340" height="104" as="geometry" />
        </mxCell>
        <mxCell id="vkV2MvF70xdshmURmsRw-4" value="&lt;b&gt;Alternativni tok B: &lt;/b&gt;Odustajanje od kreiranja ture spram zahteva" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=none;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="450" y="180" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="vkV2MvF70xdshmURmsRw-5" value="1. Vodic odustaje od kreiranja ture zatvaranjem form za izbor termina" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="vkV2MvF70xdshmURmsRw-4">
          <mxGeometry y="26" width="380" height="104" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
