        <mxCell id="Biywla8ivkZmDy_ALtEk-1" value="&lt;p style=&quot;margin: 4px 0px 0px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&amp;nbsp;Preduslov: &lt;/b&gt;Vodic je prijavljen, vodic je odabrao turu za otkazivanje&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;b&gt;Posledica: &lt;/b&gt;Odabrana tura je otkazana&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;b&gt;Osnovni tok:&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;1. Vodic odabire turu koju zeli da otkaze&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;2. Vodic klikne na dugme &quot;Cancel tour&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;3. Odabrana tura se otkazuje [Alternativni tok A]&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="Biywla8ivkZmDy_ALtEk-2" value="&lt;b&gt;Alternativni tok A: &lt;/b&gt;Istekao je rok za otkazivanje" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=none;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
