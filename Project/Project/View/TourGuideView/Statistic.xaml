<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View.TourGuideView"
        xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml" x:Class="Project.View.TourGuideView.Statistic"
        mc:Ignorable="d"
        Title="Statistic" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <TabControl>
            <TabItem Header="Highest attended">

                <StackPanel  Background="OldLace" Margin="5,0,0,5">
                    <WrapPanel>
                        <Label Content="Year: "></Label>
                        <ComboBox x:Name="yearComboBox" Width="100" Height="20" SelectedIndex="0" SelectionChanged="yearComboBox_SelectionChanged" >
                        </ComboBox>
                    </WrapPanel>

                    <WrapPanel>
                        <Label FontSize="14" Content="Tour name:"></Label>
                        <Label FontSize="14" Content="{Binding bestNameOfTour}"/>

                    </WrapPanel>
                    <WrapPanel>
                        <Label FontSize="14" Content="Date and time:"></Label>
                        <Label x:Name="dateElementHighest" FontSize="14"  Content="{Binding bestAppointmentDate}"></Label>
                    </WrapPanel>

                    <GroupBox BorderThickness="2" BorderBrush="Black" Margin="0,0,5,0">
                        <GroupBox.Header>Age statistic</GroupBox.Header>
                        <StackPanel>


                            <Label FontSize="14" Content="Under 18: "/>
                            <Grid>
                                <ProgressBar Value="{Binding bestPercent18}" Height="20" Minimum="0" Maximum="100"></ProgressBar>
                                <TextBlock HorizontalAlignment="Center" Text="{Binding bestUnder18}"></TextBlock>
                            </Grid>



                            <Label FontSize="14" Content="Between 18 and 50: "/>
                            <Grid>
                                <ProgressBar Value="{Binding bestPercent1850}" Height="20" Minimum="0" Maximum="100"></ProgressBar>
                                <TextBlock HorizontalAlignment="Center" Text="{Binding bestBetween18and50}"></TextBlock>
                            </Grid>



                            <Label FontSize="14" Content="Over 50: "/>
                            <Grid>
                                <ProgressBar Value="{Binding bestPercent50}" Height="20" Minimum="0" Maximum="100"></ProgressBar>
                                <TextBlock HorizontalAlignment="Center" Text="{Binding bestOver50}"></TextBlock>
                            </Grid>





                        </StackPanel>
                    </GroupBox>
                    <WrapPanel>
                        <Label FontSize="14" Content="Guests with coupon: "/>
                    </WrapPanel>
                    <Grid>
                        <ProgressBar Value="{Binding bestCoupon}" Height="20" Minimum="0" Maximum="100" Margin="0,0,5,0"></ProgressBar>
                        <TextBlock HorizontalAlignment="Center" Text="{Binding bestCouponPercent}"></TextBlock>
                    </Grid>

                </StackPanel>

            </TabItem>
            <TabItem Header="Other tours">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>



                    <StackPanel Grid.Column="0"  Background="OldLace" Margin="5,0,0,5">

                        <WrapPanel>
                            <Label FontSize="14" Content="Tour name:"></Label>
                            <Label FontSize="14" Content="{Binding NameOfTour}"/>

                        </WrapPanel>
                        <WrapPanel>
                            <Label FontSize="14" Content="Date and time:"></Label>
                            <Label x:Name="dateElement" FontSize="14" Visibility="Hidden" Content="{Binding AppointmentDate}"></Label>
                        </WrapPanel>

                        <GroupBox BorderThickness="2" BorderBrush="Black" Margin="0,0,5,0">
                            <GroupBox.Header>Age statistic</GroupBox.Header>
                            <StackPanel>


                                <Label FontSize="14" Content="Under 18: "/>
                                <Grid>
                                    <ProgressBar Value="{Binding Percent18}" Height="20" Minimum="0" Maximum="100"></ProgressBar>
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding Under18}"></TextBlock>
                                </Grid>



                                <Label FontSize="14" Content="Between 18 and 50: "/>
                                <Grid>
                                    <ProgressBar Value="{Binding Percent1850}" Height="20" Minimum="0" Maximum="100"></ProgressBar>
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding Between18and50}"></TextBlock>
                                </Grid>



                                <Label FontSize="14" Content="Over 50: "/>
                                <Grid>
                                    <ProgressBar Value="{Binding Percent50}" Height="20" Minimum="0" Maximum="100"></ProgressBar>
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding Over50}"></TextBlock>
                                </Grid>





                            </StackPanel>
                        </GroupBox>
                        <WrapPanel>
                            <Label FontSize="14" Content="Guests with coupon: "/>
                        </WrapPanel>
                        <Grid>
                            <ProgressBar Value="{Binding Coupon}" Height="20" Minimum="0" Maximum="100" Margin="0,0,5,0"></ProgressBar>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding CouponPercent}"></TextBlock>
                        </Grid>

                    </StackPanel>

                    <Grid Grid.Column="2" Margin="0,0,5,5" Background="OldLace">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"></RowDefinition>
                            <RowDefinition Height="6*"></RowDefinition>
                        </Grid.RowDefinitions>



                        <Label Grid.Row="0"  Content="Tour list:" FontSize="15" VerticalContentAlignment="Bottom"/>

                        <DataGrid x:Name="tourList"
                      Grid.Row="2" 
                      ItemsSource="{Binding CompletedTours, UpdateSourceTrigger=PropertyChanged}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single" 
                    SelectedItem="{Binding SelectedCompletedTour}"
                    SelectionChanged="tourList_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}"></DataGridTextColumn>
                                <DataGridTextColumn Header="Appointment" Width="2*" Binding="{Binding TourAppointment.DateAndTimeOfAppointment, StringFormat=f}"></DataGridTextColumn>
                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>





    </Grid>
</Window>
