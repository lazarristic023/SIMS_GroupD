<Window x:Class="Project.View.TourGuideView.AddNewTour"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View.TourGuideView"
        mc:Ignorable="d"
        Title="AddNewTour" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Background="AliceBlue">

        <DockPanel>

            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Button x:Name="Submit" Grid.Column="1" Margin="0,10,0,5" Width="300" HorizontalAlignment="Center" Command="{Binding SubmitCommand}">Submit</Button>
                <Button x:Name="Close" Grid.Column="0" Margin="0,10,0,5" Width="300" HorizontalAlignment="Center" Command="{Binding CloseCommand}">Close</Button>
            </Grid>
            


            <Grid DockPanel.Dock="Left" Width="400">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>

                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="75"></RowDefinition>
                        <RowDefinition Height="200"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>




                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>


                        <Label  Grid.Column="0">Tour name:</Label>
                        <TextBox x:Name="tourNameTextbox" Grid.Column="1" Height="20" Text="{Binding Path=NameOfTour, UpdateSourceTrigger=PropertyChanged}"></TextBox>



                    </Grid>

                    <GroupBox BorderBrush="Black"  Grid.Row="1">
                        <GroupBox.Header>
                            <Label Content="Location"/>
                        </GroupBox.Header>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>

                            </Grid.RowDefinitions>





                            <Grid Grid.Row="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0">
                                    <Label>Country:</Label>

                                    <ComboBox x:Name="countryComboBox" Width="120" Height="20"
                                              Text="{Binding Path=Country, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedItem="{Binding Path=Country, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding Path=Countries}" 
                                              SelectedValue="{Binding Path=Country, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsEnabled}">
                                    </ComboBox>

                                </WrapPanel>
                                <WrapPanel Grid.Column="1">
                                    <Label>City:</Label>
                                    <ComboBox x:Name="cityComboBox" Width="130" Height="20" 
                                              Text="{Binding Path=City, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding Path=Cities}"
                                              SelectedValue="{Binding Path=City}"
                                              IsEnabled="{Binding IsEnabled}"></ComboBox>
                                </WrapPanel>
                            </Grid>


                        </Grid>

                    </GroupBox>


                    <GroupBox Grid.Row="2" BorderBrush="Black">
                        <GroupBox.Header>
                            <Label>Date and time of tour start</Label>
                        </GroupBox.Header>

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition Height="110"></RowDefinition>

                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>

                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Row="0" Grid.Column="0">
                                <Label >Date:</Label>
                                <DatePicker x:Name="date" Width="130" Height="25"
                                            SelectedDate="{Binding Path=StartDate, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" 
                                            DisplayDateStart="{Binding DatePickerStartDate}"
                                            IsEnabled="{Binding IsEnabled}"></DatePicker>
                            </WrapPanel>
                            <WrapPanel Grid.Row="1" Grid.Column="0">
                                <Label Content="Time:"/>
                                <TextBox x:Name="time" ToolTip="hh:mm" Width="130" Height="20" 
                                         Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsEnabled}"></TextBox>
                            </WrapPanel>

                            <Button x:Name="AddDate" Grid.Row="0" Grid.Column="1" Margin="2,2,2,5" Content="Add date to list" Command="{Binding AddDateCommand}"/>

                            <ListBox x:Name="dateTimeList" Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Dates, UpdateSourceTrigger=PropertyChanged, StringFormat=g, ConverterCulture=fr-FR}">

                            </ListBox>





                        </Grid>


                    </GroupBox>







                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Duration (hours):</Label>
                        <TextBox Grid.Column="1" Height="20" Text="{Binding Path=Duration, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Language:</Label>
                        <ComboBox x:Name="languageComboBox" Grid.Column="1" Height="20"
                                  
                                  SelectedItem="{Binding Path=Language, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Languages}"
                                  SelectedValue="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsEnabled}">
                        </ComboBox>
                        
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0">Max number of guests:</Label>
                        <TextBox Grid.Column="1" Height="20" 
                                 Text="{Binding Path=MaxGuests, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding IsEnabled}"></TextBox>
                    </Grid>





                </Grid>
            </Grid>



            <!--DESNA STRANA-->
            <Grid DockPanel.Dock="Right" Width="350">
                <Grid.RowDefinitions>
                    <RowDefinition Height="230"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="105"></RowDefinition>
                    <RowDefinition Height="20"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>

                </Grid.RowDefinitions>


                <GroupBox Grid.Row="0" BorderBrush="black">
                    <GroupBox.Header>
                        <Label>Tour points</Label>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="70"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>


                        <Label Grid.Column="0" Grid.Row="0">Start point:</Label>
                        <TextBox x:Name="startPointTextBox" Grid.Column="1" Grid.Row="0" Height="20" Text="{Binding Path=StartPoint, UpdateSourceTrigger=PropertyChanged}" ></TextBox>



                        <Label Grid.Column="0" Grid.Row="1">End point:</Label>
                        <TextBox x:Name="endPointTextBox" Grid.Column="1" Grid.Row="1" Height="20" Text="{Binding Path=EndPoint, UpdateSourceTrigger=PropertyChanged}"></TextBox>


                        <TextBlock TextWrapping="Wrap" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">Add more points in the order in which they will be visited (optional):</TextBlock>
                        <TextBox x:Name="pointInput" Grid.Row="3" Grid.Column="0" Height="20" Text="{Binding Path=AnotherPoint, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                        <Button x:Name="AddPoints" Grid.Column="1" Grid.Row="3" Content="Add more tour points" Height="20" Margin="5,0,0,0" Command="{Binding AddPointCommand}"/>
                        <ListBox x:Name="pointsList" Grid.Row="4" Grid.ColumnSpan="2" ItemsSource="{Binding AnotherPoints, UpdateSourceTrigger=PropertyChanged}"></ListBox>

                    </Grid>
                </GroupBox>




                <Label Grid.Row="1">Description:</Label>
                <TextBox Grid.Row="2" Width="330" Height="100" TextWrapping="Wrap" Text="{Binding Path=Description, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                <Button x:Name="AddPictureButton" Grid.Row="4" Margin="10,0,10,5" Command="{Binding AddPictureCommand}">Add pictures...</Button>
                
                <ListBox x:Name="imageList" Grid.Row="5" Margin="5,0,5,0" ItemsSource="{Binding Images, UpdateSourceTrigger=PropertyChanged}">


                </ListBox>


            </Grid>
        </DockPanel>

    </Grid>
</Window>
