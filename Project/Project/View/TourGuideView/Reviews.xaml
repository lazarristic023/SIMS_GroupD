<Window x:Class="Project.View.TourGuideView.Reviews"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View.TourGuideView"
        mc:Ignorable="d"
        Title="Reviews" Height="450" Width="800"
        WindowStartupLocation="CenterOwner" Background="#28365e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="12*"></RowDefinition>
            
        </Grid.RowDefinitions>
        <Label Content="*Double click on column to see details about review" FontSize="14" Foreground="White" FontFamily="Century Gothic"/>
        <DataGrid Grid.Row="1" Margin="10,5,10,20"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  ItemsSource="{Binding TourReviews, UpdateSourceTrigger=PropertyChanged}"
                  SelectedItem="{Binding SelectedReview, UpdateSourceTrigger=PropertyChanged}"
                  GridLinesVisibility="None"
                  IsSynchronizedWithCurrentItem="True"
                  Background="#506dbb">
            <DataGrid.Resources>
                <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#3c528c"/>
                    <Setter Property="Foreground" Value="White"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#465fa4"/>
                </Style>
            </DataGrid.Resources>


            <DataGrid.InputBindings>
                <MouseBinding
                MouseAction="LeftDoubleClick"
                Command="{Binding SeeDetailsCommand}"
                CommandParameter="{Binding TourReviews/}"/>
            </DataGrid.InputBindings>
            <DataGrid.RowHeaderStyle>
                <Style/>
            </DataGrid.RowHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tour name" Width="*" Binding="{Binding tourName}"></DataGridTextColumn>
                <DataGridTextColumn Header="Rating" Width="*" Binding="{Binding avgRating}"></DataGridTextColumn>
                <DataGridTextColumn Header="Appointment" Width="*" Binding="{Binding appointment, StringFormat=g, ConverterCulture=fr-FR}"></DataGridTextColumn>
                <DataGridTextColumn Header="Guest" Width="*" Binding="{Binding userName}"></DataGridTextColumn>
                <DataGridTextColumn Header="Validity" Width="*" Binding="{Binding validity}"></DataGridTextColumn>
            </DataGrid.Columns>
            
        </DataGrid>


    </Grid>
</Window>
