<Window x:Class="Project.View.TourGuideView.TourRequests"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View.TourGuideView"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="TourRequests" Height="600" Width="600"
        >
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Height" Value="40"></Setter>
            <Setter Property="Width" Value="290"/>
            <Setter Property="FontFamily" Value="Sylfaen"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,7,10,7"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl Background="AliceBlue">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Regular tours" FontSize="25"/>
                </TabItem.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.8*"/>
                        <RowDefinition Height="1.15*"/>
                        <RowDefinition Height="0.15*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" BorderBrush="Black" BorderThickness="2">
                        <GroupBox.Header>
                            <TextBlock Text="Filter" FontSize="20"/>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Country:"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="City:"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Language:"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="Start date:"/>
                            <Label Grid.Row="1" Grid.Column="2" Content="End date:"/>
                            <Label Grid.Row="2" Grid.Column="2" Content="Number of guests:"/>
                            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Height="25" Content="Apply filter" Width="200" FontSize="14" FontFamily="Sylften">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <ComboBox Grid.Row="0" Grid.Column="1"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"/>

                            <DatePicker Grid.Row="0" Grid.Column="3" FontSize="15"/>
                            <DatePicker Grid.Row="1" Grid.Column="3" FontSize="15"/>

                            <TextBox Grid.Row="2" Grid.Column="3" Margin="0,5,0,5" HorizontalAlignment="Left" Width="30" Text="15" FontSize="14"/>

                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Back" Width="100" FontFamily="Sylften" Margin="0,3,0,3">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="1" Content="Accept selected request" FontFamily="Sylften" Margin="0,3,10,3">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" Margin="0,5,0,0"
                              Background="#F4F1De">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Country" Width="*"></DataGridTextColumn>
                            <DataGridTextColumn Header="City" Width="1.1*"></DataGridTextColumn>
                            <DataGridTextColumn Header="Language" Width="*"></DataGridTextColumn>
                            <DataGridTextColumn Header="Max guests" Width="0.7*"></DataGridTextColumn>
                            <DataGridTextColumn Header="Start date" Width="1.1*"></DataGridTextColumn>
                            <DataGridTextColumn Header="End date" Width="1.1*"></DataGridTextColumn>
                            
                        </DataGrid.Columns>
                        
                    </DataGrid>
                </Grid>
                
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Complex tours" FontSize="25"/>
                </TabItem.Header>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
