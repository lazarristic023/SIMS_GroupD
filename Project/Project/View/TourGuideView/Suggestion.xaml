<Window x:Class="Project.View.TourGuideView.Suggestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View.TourGuideView"
        mc:Ignorable="d"
        Title="Suggestion" Height="250" Width="350">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Century Gothic"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Century Gothic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="10,10,10,10">
            <WrapPanel>
                <Label Content="Most popular language is:"/>
                <Label Content="Serbian"/>
            </WrapPanel>
            <WrapPanel>
                <Label Content="Most popular location is:"/>
                <Label Content="Serbia"/>
                <Label Content=","/>
                <Label Content="Novi Sad"/>
            </WrapPanel>
        </StackPanel>



        <Button Grid.Row="1" Grid.Column="0"  Margin="10,10,10,10">
            <TextBlock Text="Make tour against language suggestion"/>
        </Button>
        <Button Grid.Row="1" Grid.Column="1" Margin="10,10,10,10" Grid.ColumnSpan="2">
            <TextBlock Text="Make tour against location suggestion"/>
        </Button>

        <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" Width="100" Height="20" VerticalAlignment="Center">
            <TextBlock Text="Close"/>
        </Button>

    </Grid>

</Window>
