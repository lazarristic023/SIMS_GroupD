<Window x:Class="Project.View.TourGuideView.TourTracking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View.TourGuideView"
        mc:Ignorable="d"
        Title="TourTracking" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Button x:Name="nextPoint" Grid.Column="0" Content="Next point" Margin="10"/>
                <Button x:Name="endTour" Grid.Column="1" Content="Finish the tour" Margin="10"/>
            </Grid>

            <Label Background="DarkGray" x:Name="tourName" DockPanel.Dock="Top" HorizontalAlignment="Center"></Label>

            <Grid DockPanel.Dock="Left" Width="300" Margin="10">
                
                
            </Grid>

            <GroupBox DockPanel.Dock="Right" Margin="10">
                <GroupBox.Header>
                    <Label>Guests</Label>
                </GroupBox.Header>
                <ListBox></ListBox>
            </GroupBox>
            
            
        </DockPanel>
        
    </Grid>
</Window>
