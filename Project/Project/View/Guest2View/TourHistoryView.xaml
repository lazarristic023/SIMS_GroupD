<Window x:Class="Project.View.TourHistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View"
        mc:Ignorable="d"
        Title="TourHistoryView" Height="768" Width="1024">
    <Grid Background="#cce0d2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="170"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <GroupBox Background="WhiteSmoke" BorderBrush="Black" BorderThickness="2" Margin="2,10,0,0" Height="160" VerticalAlignment="Top" HorizontalAlignment="Left" Width="255">
                <WrapPanel>
                    <Image Height="74" Source="../../Resources/Images/avatar.png" Width="53" VerticalAlignment="Top" Margin="10,50"/>
                    <Label FontSize="20" HorizontalContentAlignment="Center" FontWeight="Bold" Content="Bob Smith" Height="38"/>
                    <Image Height="62" Source="../../Resources/Images/bell.png" Width="47" Margin="10,0,0,0"/>
                </WrapPanel>
            </GroupBox>


            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/book.png"/>
                <Button  Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="_Active and reserved tours" Click="Button_Click_Active_Tours"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="2" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/compass.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Available tours" Click="Button_Click_Back"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="3" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/request1.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Tour requests"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="4" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/question-mark.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Complex tour requests"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="5" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/discount.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Vouchers" Click="Button_Click_Vouchers"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="6" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/ancient-scroll.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Tour history"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="7" Margin="90,0,0,0">
                <Image Height="25" Source="../../Resources/Images/logout.png"/>
                <Button x:Name="btSignOut" Background="Transparent" BorderBrush="Transparent" Content="Sign out" Margin="2" HorizontalAlignment="Right" Click="btSignOut_Click" FontWeight="DemiBold" FontSize="19"/>
            </WrapPanel>
        </Grid>
        <GroupBox Background="WhiteSmoke" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="10">
            <Grid Grid.Column="1">
                <Button Margin="0,8,647,643" Content="&lt;" Background="Transparent" BorderThickness="0" FontSize="30" Click="Button_Click_Back"/>
                <TextBlock FontWeight="Bold" FontSize="35" Text="Tour history" HorizontalAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Top"/>
                <Separator Margin="0,28,0,617" Background="Black"/>

                <TextBlock FontWeight="Medium" FontSize="20" Text="Tours you have been on:"  Margin="35,132,453,529"/>

                <DataGrid x:Name="myDataGrid" AutoGenerateColumns="False" Margin="35,177,63,383">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Location" Binding="{Binding ExpirationDate}" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}"/>
                        <DataGridTextColumn Header="Guide" Binding="{Binding Guide}"/>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="tbReviewTour" MouseLeftButtonUp="tbReviewTour_MouseLeftButtonUp" TextDecorations="Underline" Text="Review tour" Foreground="Blue"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
        
    </Grid>
</Window>
