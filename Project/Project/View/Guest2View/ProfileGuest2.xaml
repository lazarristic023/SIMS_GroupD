<Window x:Class="Project.View.ProfileGuest2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View"
        mc:Ignorable="d"
        Title="ProfileGuest2" Height="768" Width="1024">
    <Grid Background="#cce0d2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="170"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <GroupBox Background="WhiteSmoke" BorderBrush="Black" BorderThickness="2" Margin="2,10,0,0" Height="160" VerticalAlignment="Top" HorizontalAlignment="Left" Width="255">
                <WrapPanel>
                    <Image Height="74" Source="../../Resources/Images/avatar.png" Width="53" VerticalAlignment="Top" Margin="10,50"/>
                    <Label FontSize="20" HorizontalContentAlignment="Center" FontWeight="Bold" Content="Bob Smith" Height="38"/>
                    <Image Height="62" Source="../../Resources/Images/bell.png" Width="47" Margin="10,0,0,0"/>
                </WrapPanel>
            </GroupBox>


            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/book.png"/>
                <Button  Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="_Active and reserved tours"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="2" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/compass.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Available tours" Click="Button_Click_AvailableTours"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="3" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/request1.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Tour requests"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="4" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/question-mark.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Complex tour requests"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="5" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/discount.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Vouchers" Click="Button_Click_Vouchers"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="6" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/ancient-scroll.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Tour history" Click="Button_Click_Tour_History"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="7" Margin="90,0,0,0">
                <Image Height="25" Source="../../Resources/Images/logout.png"/>
                <Button x:Name="btSignOut" Background="Transparent" BorderBrush="Transparent" Content="Sign out" Margin="2" HorizontalAlignment="Right" Click="btSignOut_Click" FontWeight="DemiBold" FontSize="19"/>
            </WrapPanel>



        </Grid>

        <GroupBox Background="WhiteSmoke" BorderBrush="Black" BorderThickness="2" Grid.Column="2" Margin="10,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" BorderBrush="Transparent" BorderThickness="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="20,19,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="30" Text="Currently active tour"/>

                        <GroupBox Grid.Row="1" BorderBrush="Black" BorderThickness="2" Margin="20,0,20,20">
                            <Grid>
                                <TextBlock Margin="14,14,395,190" FontSize="22" Text="Name of active tour"/>
                                <TextBlock Margin="14,56,456,148" FontSize="19" Text="City, Country"/>
                                <TextBlock Margin="14,92,456,112" FontSize="19" Text="Guide: Guide1"/>


                                <TextBlock Margin="519,56,-49,149" FontSize="19" Text="Language: lang"/>
                                <TextBlock Margin="481,92,-11,113" FontSize="19" Text="Duration: duration1"/>

                                <TextBlock Margin="14,124,368,81" FontSize="19" Text="Current checkpoint: checkpoint"/>

                                <GroupBox BorderBrush="Black" BorderThickness="2" Margin="14,163,10,39">
                                    <Grid>
                                        <TextBlock Text="Confirm attendance" VerticalAlignment="Center" FontSize="19" Margin="14,0,-14,0"/>
                                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="19" Content="Attendance"/>
                                    </Grid>
                                </GroupBox>

                                <Button Content="View details" Margin="570,225,12,0" />

                            </Grid>
                        </GroupBox>

                        <Separator Margin="20,270,20,-16" Grid.Row="1" Background="Black" />

                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" BorderBrush="Transparent" BorderThickness="0">
                    <Grid>
                        <TextBlock Grid.Row="0" Margin="26,25,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="30" Text="My reserved tours"/>
                        <DataGrid x:Name="myDataGrid" AutoGenerateColumns="False" Margin="27,90,28,91" Height="175">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Location" Binding="{Binding ExpirationDate}" />
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}"/>
                                <DataGridTextColumn Header="Guide" Binding="{Binding Guide}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    
                </GroupBox>
            </Grid>
        </GroupBox>


    </Grid>
</Window>
