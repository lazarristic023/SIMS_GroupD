<Window x:Class="Project.View.TourReviewing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View"
        mc:Ignorable="d"
        Title="TourReviewing" Height="768" Width="1024">
    <Grid Background="#cce0d2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="170"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <GroupBox Background="WhiteSmoke" BorderBrush="Black" BorderThickness="2" Margin="2,10,0,0" Height="160" VerticalAlignment="Top" HorizontalAlignment="Left" Width="255">
                <WrapPanel>
                    <Image Height="74" Source="../../Resources/Images/avatar.png" Width="53" VerticalAlignment="Top" Margin="10,50"/>
                    <Label FontSize="20" HorizontalContentAlignment="Center" FontWeight="Bold" Content="Bob Smith" Height="38"/>
                    <Image Height="62" Source="../../Resources/Images/bell.png" Width="47" Margin="10,0,0,0"/>
                </WrapPanel>
            </GroupBox>


            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/book.png"/>
                <Button  Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="_Active and reserved tours"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="2" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/compass.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Available tours" Click="Button_Click_AvailableTours"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="3" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/request1.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Tour requests"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="4" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/question-mark.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Complex tour requests"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="5" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/discount.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Vouchers" Click="Button_Click_Vouchers"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="6" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/ancient-scroll.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Tour history" Click="Button_Click_Tour_History"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="7" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/logout.png"/>
                <Button x:Name="btSignOut" Background="Transparent" BorderBrush="Transparent" Content="Sign out" Margin="2" HorizontalAlignment="Right" Click="btSignOut_Click" FontWeight="DemiBold" FontSize="19">

                </Button>
            </WrapPanel>

        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <GroupBox Background="WhiteSmoke" BorderBrush="Black" BorderThickness="2" Margin="2" Grid.Row="0">
                <Grid>
                    <Button Height="50" Width="50" Margin="10,3,690,274" Content="&lt;" Background="Transparent" BorderThickness="0" FontSize="30" Click="Button_Click_Back">

                    </Button>
                    <TextBlock FontWeight="Bold" FontSize="35" Text="Tour review info" HorizontalAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Top"/>

                    <Label Content="Name:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="158,72,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBlock HorizontalAlignment="Left" Margin="332,79,0,0" Width="auto" Text="Obilazak Beograda" VerticalAlignment="Top" FontSize="15"/>

                    <Label Content="City:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="158,109,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <Label Content="Country:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="156,146,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBlock HorizontalAlignment="Left" Margin="332,116,0,0" Width="auto" Text="Beograd" VerticalAlignment="Top" FontSize="15"/>
                    <TextBlock HorizontalAlignment="Left" Margin="332,153,0,0" Width="auto" Text="Srbija" VerticalAlignment="Top" FontSize="15"/>

                    <Label Content="Max number of guests:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="156,183,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBlock HorizontalAlignment="Left" Margin="332,190,0,0" Width="auto" Text="20" VerticalAlignment="Top" FontSize="15"/>

                    <Label Content="Duration (in hours):" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="156,220,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBlock HorizontalAlignment="Left" Margin="332,227,0,0" Width="auto" Text="4" VerticalAlignment="Top" FontSize="15"/>

                    <Label Content="Language:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="156,257,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBlock HorizontalAlignment="Left" Margin="332,268,0,0" Width="auto" Text="Srbija" VerticalAlignment="Top" FontSize="15"/>
                    <Separator Margin="0,31,0,220" Background="Black"/>

                </Grid>
            </GroupBox>

            <GroupBox Background="WhiteSmoke" BorderBrush="Black" BorderThickness="2" Margin="2" Grid.Row="1">
                <Grid>
                    <Label Content="Submit images:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="309,52,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBox x:Name="txtInput" Margin="429,55,98,284">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <ListBox Height="70" Margin="429,133,93,204" x:Name="lstItems"/>
                    <Button Content="Add" FontSize="17" Margin="662,63,26,305" Click="Button_Add_Image_Click" RenderTransformOrigin="0.5,0.5" >
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleY="1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Button.RenderTransform>
                    </Button>

                    <Label Content="Guide knowledge:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="44,58,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBox Margin="196,63,469,307">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Label Content="Guide language:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="44,99,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBox Margin="196,105,469,265">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Label Content="Tour amusement:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="44,140,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBox Margin="196,147,469,223">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Label Content="Comment:" FontWeight="DemiBold" HorizontalAlignment="Left" Margin="323,242,0,0" VerticalAlignment="Top" FontSize="15"/>
                    <TextBox Margin="409,242,84,96">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button x:Name="btTourReview" Content="Review" Margin="0,328,26,31" HorizontalAlignment="Right" Click="Button_Click_Back" FontWeight="DemiBold" FontSize="19" Width="78">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                </Grid>
            </GroupBox>
        </Grid>

    </Grid>
</Window>
