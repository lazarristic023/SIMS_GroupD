<Window x:Class="Project.View.MyReservedTourInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View"
        mc:Ignorable="d"
        Title="MyReservedTourInfo" Height="768" Width="1024">
    <Grid Background="#cce0d2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="170"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <GroupBox Background="WhiteSmoke" BorderBrush="Black" BorderThickness="2" Margin="2,10,0,0" Height="160" VerticalAlignment="Top" HorizontalAlignment="Left" Width="255">
                <WrapPanel>
                    <Image Height="74" Source="../../Resources/Images/avatar.png" Width="53" VerticalAlignment="Top" Margin="10,50"/>
                    <Label FontSize="20" HorizontalContentAlignment="Center" FontWeight="Bold" Content="Bob Smith" Height="38"/>
                    <Image Height="62" Source="../../Resources/Images/bell.png" Width="47" Margin="10,0,0,0"/>
                </WrapPanel>
            </GroupBox>


            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/book.png"/>
                <Button  Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="_Active and reserved tours"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="2" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/compass.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Available tours" />
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="3" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/request1.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Tour requests"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="4" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/question-mark.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Complex tour requests"/>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="5" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/discount.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Vouchers" />
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="6" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/ancient-scroll.png"/>
                <Button Cursor="Hand" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" FontWeight="DemiBold" FontSize="19" Content="Tour history" />
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="7" Margin="10,0,0,0">
                <Image Height="25" Source="../../Resources/Images/logout.png"/>
                <Button x:Name="btSignOut" Background="Transparent" BorderBrush="Transparent" Content="Sign out" Margin="2" HorizontalAlignment="Right"  FontWeight="DemiBold" FontSize="19"/>
            </WrapPanel>

        </Grid>

        <GroupBox Background="WhiteSmoke" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="10">
            <Grid>

                <TextBlock FontWeight="Bold" FontSize="35" Text="Tour Info" HorizontalAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Top"/>
                <Separator Margin="0,55,0,622" Background="Black"/>

                <TextBlock Text="Name:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="185,108,0,0"/>
                <TextBlock Text="Obilazak Subotice" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="357,108,0,0"/>

                <TextBlock Text="City:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="188,145,0,0" />
                <TextBlock Text="Subotica" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="358,148,0,0"/>

                <TextBlock Text="Country:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="188,185,0,0" />
                <TextBlock Text="Srbija" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="357,186,0,0"/>

                <TextBlock Text="Language:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="188,221,0,0" />
                <TextBlock Text="Srpski" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="357,224,0,0"/>

                <TextBlock Text="Duration (in hours):" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="188,259,0,0" />
                <TextBlock Text="2" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="368,259,0,0"/>

                <TextBlock Text="Guide:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="188,300,0,0" />
                <TextBlock Text="Guide 1" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="362,298,0,0"/>

                <TextBlock Text="Max guests:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="188,342,0,0" />
                <TextBlock Text="10" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="19" Margin="366,342,0,0"/>

                <Button Content="Generate PDF" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="459,422,0,0" FontSize="19" Command="{Binding GeneratePdfCommand}" Height="39" Width="131">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>


            </Grid>
        </GroupBox>

    </Grid>
</Window>
