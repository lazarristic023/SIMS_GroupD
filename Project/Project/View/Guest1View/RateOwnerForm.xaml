<Window x:Class="Project.View.Guest1View.RateOwnerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View.Guest1View"
        mc:Ignorable="d"
        Title="RateOwnerForm" Height="500" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="0.9*"/>
        </Grid.RowDefinitions>

        <WrapPanel VerticalAlignment="Center" Margin="70,0,0,0">
            <TextBlock TextDecorations="Underline" FontWeight="DemiBold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Rate Owner and Accommodation"/>
            <Image Margin="30,0,0,0" Stretch="Uniform" Height="25" Source="../../Resources/Images/infoIcon.png"/>
        </WrapPanel>

        <Grid Margin="0,8,0,0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Cleanliness:"/>
            <TextBlock Grid.Row="1" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Owner behaviour:"/>

            <WrapPanel VerticalAlignment="Center" Grid.Column="1">
                <Slider IsSnapToTickEnabled="True" TickFrequency="1" x:Name="sliderClean" Value="{Binding Path=Cleanliness,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="5" VerticalAlignment="Center" Width="160"/>
                <Label x:Name="lblClean" BorderBrush="Black" BorderThickness="1" FontSize="16" Content="{Binding ElementName=sliderClean,Path=Value}" Margin="15,0,0,0"/>
            </WrapPanel>

            <WrapPanel VerticalAlignment="Center" Grid.Column="1" Grid.Row="1">
                <Slider IsSnapToTickEnabled="True" TickFrequency="1" x:Name="sliderBehaviour" Value="{Binding Path=OwnerBehaviour, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="5" VerticalAlignment="Center" Width="160"/>
                <Label x:Name="lblBehaviour" BorderBrush="Black" BorderThickness="1" FontSize="16" Content="{Binding ElementName=sliderBehaviour,Path=Value}" Margin="15,0,0,0"/>
            </WrapPanel>

        </Grid>

        <StackPanel Margin="35,5" Grid.Row="2">
            <Label Content="Write an additional comment:"/>
            <TextBox Text="{Binding Path=Comment,Mode=OneWayToSource, UpdateSourceTrigger=LostFocus}" VerticalScrollBarVisibility="Visible" Height="80" AcceptsReturn="True" AcceptsTab="True" SpellCheck.IsEnabled="True" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Margin="35,5" Grid.Row="3">
            <WrapPanel>
                <Label Content="Add images:"/>
                <TextBox x:Name="tbImageUrl" VerticalContentAlignment="Center" Text="Paste image link" Width="240" Margin="15,0,0,0"/>
                <Button x:Name="btnAddImage" Click="btnAddImage_Click" Content="Add" Margin="10,0,0,0" Width="60"/>
            </WrapPanel>
            <ListView ItemsSource="{Binding Path=ImageUrls, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Height="60"/>
        </StackPanel>

        <Grid Margin="35,0" Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock FontSize="12" VerticalAlignment="Center"  Text="Does accommodaiton need renovation?"/>
            <TextBlock x:Name="tbRenovation" Grid.Row="1" FontSize="15" Foreground="Gray" VerticalAlignment="Center" Text="Renovation emergency level:"/>

            <WrapPanel VerticalAlignment="Center" Grid.Column="1">
                <CheckBox x:Name="chbRenovation" Unchecked="chbRenovation_Unchecked" Checked="chbRenovation_Checked" IsChecked="False" Margin="20,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="Yes" FontSize="14"/>
                <Image Stretch="Uniform"  Height="22" Source="../../Resources/Images/infoIcon.png"/>
            </WrapPanel>

            <WrapPanel Name="wpRenovation" IsEnabled="False" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1">
                <Slider IsSnapToTickEnabled="True" TickFrequency="1" x:Name="sliderRenovation" Value="{Binding Path=RenovationEmergencyLevel, Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="5" VerticalAlignment="Center" Width="160"/>
                <Label x:Name="lblRenovation" BorderBrush="Gray" BorderThickness="1" FontSize="16" Content="{Binding ElementName=sliderRenovation,Path=Value}" Margin="15,0,0,0"/>
            </WrapPanel>

        </Grid>

        <Button x:Name="btnSendRecension" Click="btnSendRecension_Click" Content="Send recension" Grid.Row="5" Height="20" Width="90"/>

    </Grid>
</Window>
